{
  "manifest_version": 3,
  "name": "网申轻填 · 本地简历助手",
  "version": "0.1.2",
  "description": "在本机整理简历，识别网申字段，确认后选择填写或复制。",
  "minimum_chrome_version": "122",
  "permissions": ["storage", "activeTab", "tabs", "scripting", "sidePanel", "clipboardWrite"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "打开网申轻填", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" } },
  "side_panel": { "default_path": "index.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self';" }
}
